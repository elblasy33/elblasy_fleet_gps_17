<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fleet_gps" model="ir.module.category">
        <field name="name">Fleet GPS</field>
        <field name="description">GPS tracking for Fleet vehicles.</field>
        <field name="sequence">18</field>
    </record>
    <record id="group_gps_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_fleet_gps"/>
        <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_user'))]"/>
    </record>
    <record id="group_gps_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_fleet_gps"/>
        <field name="implied_ids" eval="[(4, ref('group_gps_user')), (4, ref('fleet.fleet_group_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_gps_server_company" model="ir.rule">
        <field name="name">GPS server: multi company</field>
        <field name="model_id" ref="model_fleet_gps_server"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_gps_device_company" model="ir.rule">
        <field name="name">GPS device: multi company</field>
        <field name="model_id" ref="model_fleet_gps_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_gps_position_company" model="ir.rule">
        <field name="name">GPS position: multi company</field>
        <field name="model_id" ref="model_fleet_gps_position"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_gps_geofence_company" model="ir.rule">
        <field name="name">GPS geofence: multi company</field>
        <field name="model_id" ref="model_fleet_gps_geofence"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_gps_daily_company" model="ir.rule">
        <field name="name">GPS daily: multi company</field>
        <field name="model_id" ref="model_fleet_gps_daily"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_gps_trip_company" model="ir.rule">
        <field name="name">GPS trip: multi company</field>
        <field name="model_id" ref="model_fleet_gps_trip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_gps_stop_company" model="ir.rule">
        <field name="name">GPS stop: multi company</field>
        <field name="model_id" ref="model_fleet_gps_stop"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_gps_backfill_company" model="ir.rule">
        <field name="name">GPS history import: multi company</field>
        <field name="model_id" ref="model_fleet_gps_backfill"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_gps_event_company" model="ir.rule">
        <field name="name">GPS event: multi company</field>
        <field name="model_id" ref="model_fleet_gps_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
