<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elblasy_fleet_gps.Map">
        <div class="o_gps_map" t-ref="rootRef" t-att-class="{ o_gps_list_open: state.listOpen, o_gps_has_sel: selectedRow }">
            <!-- ============================================================ vehicle list -->
            <aside class="o_gps_panel">
                <div class="o_gps_panel_head">
                    <span class="o_gps_live" t-att-class="{ o_gps_live_err: state.error }"/>
                    <span class="o_gps_title">Live map</span>
                    <span class="o_gps_total" t-out="counts.all"/>
                    <button class="o_gps_x d-md-none" t-on-click="() => this.state.listOpen = false" title="Close"><i class="fa fa-times"/></button>
                </div>
                <div class="o_gps_search">
                    <i class="fa fa-search"/>
                    <input type="search" placeholder="Search plate, driver…" t-att-value="state.search" t-on-input="onSearch"/>
                </div>
                <div class="o_gps_chips">
                    <button t-foreach="filters" t-as="f" t-key="f.key" class="o_gps_chip"
                            t-att-class="{ active: state.filter === f.key }" t-on-click="() => this.state.filter = f.key">
                        <t t-out="f.label"/> <span class="o_gps_chip_n" t-out="f.count"/>
                    </button>
                </div>
                <div t-if="state.error" class="o_gps_error" t-out="state.error"/>
                <div class="o_gps_rows">
                    <button t-foreach="rows" t-as="r" t-key="r.d.id" class="o_gps_row"
                            t-att-class="{ active: state.selected === r.d.id }" t-on-click="() => this.select(r.d.id)">
                        <span class="o_gps_dot" t-att-style="'background:' + r.color"/>
                        <span class="o_gps_row_main">
                            <span class="o_gps_row_name" t-out="r.d.plate or r.d.name"/>
                            <span class="o_gps_row_sub">
                                <t t-if="r.d.driver"><t t-out="r.d.driver"/> · </t><t t-out="stateLabel(r.d)"/>
                            </span>
                        </span>
                        <span class="o_gps_row_side">
                            <span t-if="r.vs === 'moving' or r.vs === 'over'" class="o_gps_speed" t-att-style="'color:' + r.color"><t t-out="fmtSpeed(r.d.speed)"/> <small>km/h</small></span>
                            <span class="o_gps_ago" t-out="ago(r.d.last_update or r.d.fix_time)"/>
                        </span>
                    </button>
                    <div t-if="!state.loading and !rows.length" class="o_gps_empty">
                        <i class="fa fa-car"/>
                        <span t-if="counts.all">No vehicle matches.</span>
                        <span t-else="">No GPS device yet. Import them from Configuration → Servers.</span>
                    </div>
                </div>
            </aside>
            <!-- ============================================================ map -->
            <div class="o_gps_stage">
                <div class="o_gps_canvas" t-ref="mapRef"/>
                <div t-if="state.noGl" class="o_gps_nogl">
                    <i class="fa fa-exclamation-triangle"/>
                    <span>This browser cannot draw the map (WebGL is unavailable). The vehicle list still works.</span>
                </div>
                <button class="o_gps_fab d-md-none" t-on-click="() => this.state.listOpen = true">
                    <i class="fa fa-list"/><span t-out="counts.all"/>
                </button>
                <div class="o_gps_tools">
                    <div class="o_gps_tool_wrap">
                        <button class="o_gps_tool" title="Map style" t-on-click="() => this.state.styleMenu = !this.state.styleMenu"><i class="fa fa-clone"/></button>
                        <div t-if="state.styleMenu" class="o_gps_menu">
                            <button t-foreach="styles" t-as="s" t-key="s.key" t-att-class="{ active: state.style === s.key }" t-on-click="() => this.setStyle(s.key)">
                                <t t-out="s.label"/><i t-if="state.style === s.key" class="fa fa-check ms-auto"/>
                            </button>
                        </div>
                    </div>
                    <button class="o_gps_tool" title="Show all vehicles" t-on-click="fitAll"><i class="fa fa-crosshairs"/></button>
                    <button class="o_gps_tool" t-att-class="{ on: state.labels }" title="Plate labels" t-on-click="toggleLabels"><i class="fa fa-tag"/></button>
                    <button class="o_gps_tool" t-att-class="{ on: state.trails }" title="Movement trails" t-on-click="toggleTrails"><i class="fa fa-line-chart"/></button>
                    <button class="o_gps_tool" t-att-class="{ on: state.fences }" title="Geofences" t-on-click="toggleFences"><i class="fa fa-compass"/></button>
                    <button class="o_gps_tool" title="Full screen" t-on-click="toggleFullscreen"><i class="fa fa-expand"/></button>
                </div>
                <div class="o_gps_legend d-none d-md-flex">
                    <span t-foreach="legend" t-as="l" t-key="l.vs"><i t-att-style="'background:' + l.color"/><t t-out="l.label"/></span>
                </div>
                <!-- ======================================================== selected vehicle -->
                <div t-if="selectedRow" class="o_gps_card">
                    <t t-set="r" t-value="selectedRow"/>
                    <div class="o_gps_card_head">
                        <span class="o_gps_dot" t-att-style="'background:' + r.color"/>
                        <div class="o_gps_card_title">
                            <b t-out="r.d.plate or r.d.name"/>
                            <small><t t-out="stateLabel(r.d)"/><t t-if="r.d.driver"> · <t t-out="r.d.driver"/></t></small>
                        </div>
                        <button class="o_gps_x" t-on-click="closeCard" title="Close"><i class="fa fa-times"/></button>
                    </div>
                    <div class="o_gps_stats">
                        <div><i class="fa fa-tachometer"/><b><t t-out="fmtSpeed(r.d.speed)"/></b><small>km/h</small></div>
                        <div><i class="fa fa-key"/><b t-out="r.d.ignition ? ignitionOn : ignitionOff"/><small>Ignition</small></div>
                        <div t-if="r.d.battery"><i class="fa fa-battery-full"/><b><t t-out="Math.round(r.d.battery)"/>%</b><small>Battery</small></div>
                        <div><i class="fa fa-clock-o"/><b t-out="ago(r.d.fix_time)"/><small>Last fix</small></div>
                    </div>
                    <div class="o_gps_since" t-if="state.extra">
                        <span t-if="state.extra.since_motion"><i class="fa fa-clock-o"/><t t-if="r.vs === 'moving' or r.vs === 'over'">Moving for</t><t t-else="">Stopped for</t> <b t-out="since(state.extra.since_motion)"/></span>
                        <span t-if="state.extra.since_ignition"><i class="fa fa-key"/><t t-if="r.d.ignition">Engine on for</t><t t-else="">Engine off for</t> <b t-out="since(state.extra.since_ignition)"/></span>
                        <span t-if="state.extra.still and !(r.vs === 'moving' or r.vs === 'over')"><i class="fa fa-map-marker"/>At this place <t t-if="state.extra.still.at_least">for over </t><b t-out="since(state.extra.still.since)"/></span>
                        <span t-if="state.extra.silence" class="o_gps_silence"><i class="fa fa-exclamation-triangle"/><t t-out="silenceText"/></span>
                    </div>
                    <div class="o_gps_addr" t-if="r.d.address or (state.extra and state.extra.address)"><i class="fa fa-map-marker"/><span t-out="r.d.address or state.extra.address"/></div>
                    <div class="o_gps_coords" t-if="r.d.lat or r.d.lon"><t t-out="r.d.lat.toFixed(5)"/>, <t t-out="r.d.lon.toFixed(5)"/></div>
                    <button class="o_gps_more" t-on-click="toggleDetails"><i t-attf-class="fa fa-{{state.details ? 'angle-up' : 'angle-down'}}"/> <t t-if="state.details">Hide details</t><t t-else="">Vehicle details</t></button>
                    <div class="o_gps_details" t-if="state.details">
                        <div t-if="r.d.vehicle"><span>Vehicle</span><b t-out="r.d.vehicle"/></div>
                        <div t-if="r.d.driver"><span>Driver</span><b t-out="r.d.driver"/></div>
                        <div t-if="r.d.imei"><span>IMEI</span><b dir="ltr" t-out="r.d.imei"/><button t-on-click="() => this.copy(r.d.imei)" title="Copy"><i class="fa fa-files-o"/></button></div>
                        <div t-if="r.d.phone"><span>SIM</span><a t-att-href="'tel:' + r.d.phone" dir="ltr" t-out="r.d.phone"/><button t-on-click="() => this.copy(r.d.phone)" title="Copy"><i class="fa fa-files-o"/></button></div>
                        <div t-if="r.d.iccid"><span>ICCID</span><b dir="ltr" t-out="r.d.iccid"/><button t-on-click="() => this.copy(r.d.iccid)" title="Copy"><i class="fa fa-files-o"/></button></div>
                        <div t-if="r.d.model"><span>Device model</span><b t-out="r.d.model"/></div>
                        <div t-if="r.d.group"><span>Group</span><b t-out="r.d.group"/></div>
                        <div t-if="r.d.subscription_end"><span>Subscription ends</span><b t-att-class="r.d.subscription_state === 'expired' ? 'text-danger' : ''" t-out="r.d.subscription_end"/></div>
                        <div t-if="state.extra and state.extra.events.length" class="o_gps_events">
                            <span>Latest events</span>
                            <ul><li t-foreach="state.extra.events" t-as="e" t-key="e_index"><t t-out="e.label"/> <small t-out="e.time"/></li></ul>
                        </div>
                    </div>
                    <div class="o_gps_card_actions">
                        <button class="btn btn-sm btn-primary" t-on-click="() => this.openVehicle(r.d)"><i class="fa fa-car me-1"/>Vehicle</button>
                        <button class="btn btn-sm btn-secondary" t-on-click="() => this.openPlayback(r.d)"><i class="fa fa-history me-1"/>Playback</button>
                        <button class="btn btn-sm btn-secondary" t-att-class="{ active: state.follow }" t-on-click="toggleFollow"><i class="fa fa-crosshairs me-1"/>Follow</button>
                        <button class="btn btn-sm btn-secondary" t-on-click="() => this.openMapsLink(r.d)"><i class="fa fa-compass me-1"/>Directions</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
