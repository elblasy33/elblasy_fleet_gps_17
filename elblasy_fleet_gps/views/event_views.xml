<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gps_event_view_list" model="ir.ui.view">
        <field name="name">fleet.gps.event.list</field>
        <field name="model">fleet.gps.event</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" decoration-bf="not seen" decoration-danger="type == 'alarm'" decoration-warning="type == 'deviceOverspeed'">
                <field name="event_time"/>
                <field name="device_id"/>
                <field name="type"/>
                <field name="vehicle_id" optional="hide"/>
                <field name="alarm" optional="show"/>
                <field name="geofence_id" optional="show"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="seen" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="gps_event_view_search" model="ir.ui.view">
        <field name="name">fleet.gps.event.search</field>
        <field name="model">fleet.gps.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="device_id"/>
                <field name="vehicle_id"/>
                <field name="geofence_id"/>
                <filter name="unseen" string="Unseen" domain="[('seen', '=', False)]"/>
                <filter name="last7" string="Last 7 days" domain="[('event_time', '&gt;=', (context_today() - datetime.timedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="f_alarm" string="Alarms" domain="[('type', '=', 'alarm')]"/>
                <filter name="f_overspeed" string="Overspeed" domain="[('type', '=', 'deviceOverspeed')]"/>
                <filter name="f_geofence" string="Geofences" domain="[('type', 'in', ('geofenceEnter', 'geofenceExit'))]"/>
                <filter name="f_ignition" string="Ignition" domain="[('type', 'in', ('ignitionOn', 'ignitionOff'))]"/>
                <filter name="f_motion" string="Moving / stopped" domain="[('type', 'in', ('deviceMoving', 'deviceStopped'))]"/>
                <filter name="f_connection" string="Connection" domain="[('type', 'in', ('deviceOnline', 'deviceOffline', 'deviceUnknown', 'deviceInactive'))]"/>
                <group>
                    <filter name="g_type" string="Type" context="{'group_by': 'type'}"/>
                    <filter name="g_device" string="Device" context="{'group_by': 'device_id'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'event_time:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="gps_event_view_graph" model="ir.ui.view">
        <field name="name">fleet.gps.event.graph</field>
        <field name="model">fleet.gps.event</field>
        <field name="arch" type="xml">
            <graph string="Events" type="bar" sample="1">
                <field name="type"/>
            </graph>
        </field>
    </record>
    <record id="gps_event_action" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">fleet.gps.event</field>
        <field name="view_mode">tree,graph</field>
        <field name="context">{'search_default_last7': 1}</field>
    </record>
    <record id="gps_event_action_seen" model="ir.actions.server">
        <field name="name">Mark as seen</field>
        <field name="model_id" ref="model_fleet_gps_event"/>
        <field name="binding_model_id" ref="model_fleet_gps_event"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_mark_seen()</field>
    </record>
    <menuitem id="menu_gps_events" name="Events" parent="menu_gps_root" action="gps_event_action" sequence="25"/>
</odoo>
